[Unit]
Description=Open Voice Input Linux standalone voice daemon
Documentation=https://github.com/SidUParis/openVoiceInput_linux
After=graphical-session.target murmur-ime-engine.service
Wants=murmur-ime-engine.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=@VOICE_EXEC@ run --config @VOICE_CONFIG@ --vocabulary @VOICE_VOCABULARY@ --corrections @VOICE_CORRECTIONS@ --adaptive-corrections @VOICE_ADAPTIVE_CORRECTIONS@ --data-collection @VOICE_DATA_COLLECTION@ --microphone-priority @VOICE_MICROPHONE_PRIORITY@ --interaction @VOICE_INTERACTION@ --output-style @VOICE_OUTPUT_STYLE@ --output-target @VOICE_OUTPUT_TARGET@
ExecStopPost=@VOICE_EXEC@ restore-engine
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=2
TimeoutStopSec=30
UMask=0077
RuntimeDirectory=murmur-ime murmur-ime-private
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
PrivateTmp=yes
# Keep the private temporary directory while exposing only the public X11
# socket directory needed by the explicitly armed clipboard target. The
# optional prefix keeps Wayland-only hosts without X11 usable.
BindReadOnlyPaths=-/tmp/.X11-unix
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
